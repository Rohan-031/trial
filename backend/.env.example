# MongoDB connection string (required) - same variable the Node app used
CONN_STRING=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# HTTP port for the REST API (default 5000, as in the Node app)
PORT=5000

# Clerk secret key, used by GET /api/users/login/:uname to list Clerk users
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Socket.IO server port (Node shared the HTTP port; Java needs a separate one)
SOCKET_PORT=9092

# Origin allowed to connect to Socket.IO (Vite dev server)
SOCKET_CORS_ORIGIN=http://localhost:5173
